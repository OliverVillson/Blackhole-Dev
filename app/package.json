{
  "name": "blackhole-dev-app",
  "productName": "BlackHole-Dev",
  "version": "0.1.0",
  "private": true,
  "description": "BlackHole-Dev desktop app: write Python recipes, plan them, run them on your VM.",
  "author": "BlackHole-Harness",
  "license": "Apache-2.0",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64",
    "start": "electron-vite preview",
    "test:e2e": "electron-vite build && xvfb-run -a node test/e2e/smoke.mjs",
    "postinstall": "electron-builder install-app-deps || echo 'node-pty rebuild skipped: the terminal falls back to plain pipes'; node scripts/ensure-electron.mjs",
    "predev": "node scripts/ensure-electron.mjs",
    "doctor": "node scripts/ensure-electron.mjs --doctor"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/anonymous-pro": "^5.3.0",
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/azeret-mono": "^5.3.0",
    "@fontsource/b612-mono": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dotgothic16": "^5.3.1",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inconsolata": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "@fontsource/oxanium": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/red-hat-mono": "^5.3.0",
    "@fontsource/rubik-glitch": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.1",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@fontsource/syne-mono": "^5.3.0",
    "@fontsource/titillium-web": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@fontsource/victor-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "dev.blackholeharness.app",
    "productName": "BlackHole-Dev",
    "copyright": "BlackHole-Harness",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "BlackHole-Dev"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OliverVillson",
        "repo": "Blackhole-Dev",
        "private": true
      }
    ]
  }
}
