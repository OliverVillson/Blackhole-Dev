{
  "name": "blackhole-dev-app",
  "productName": "BlackHole-Dev",
  "version": "0.1.0",
  "private": true,
  "description": "BlackHole-Dev desktop app: write Python recipes, plan them, run them on your VM.",
  "author": "BlackHole-Harness",
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64",
    "start": "electron-vite preview",
    "test:e2e": "electron-vite build && xvfb-run -a node test/e2e/smoke.mjs",
    "postinstall": "electron-builder install-app-deps || echo 'node-pty rebuild skipped: the terminal falls back to plain pipes'"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "dev.blackholeharness.app",
    "productName": "BlackHole-Dev",
    "copyright": "BlackHole-Harness",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "BlackHole-Dev"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OliverVillson",
        "repo": "Blackhole-Dev",
        "private": true
      }
    ]
  }
}
